// Voxi data model. See plan.md §5.
// Every row is scoped by userId so multi-user later needs no schema change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum Priority {
  low
  medium
  high
  urgent
}

enum ReminderKind {
  reminder
  morning_briefing
  evening_review
}

enum PlanStatus {
  proposed
  accepted
  superseded
}

enum ReminderStatus {
  scheduled
  fired
  snoozed
  cancelled
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  timezone     String   @default("UTC")
  // Working hours as minutes after local midnight; planning fills tasks into this window.
  workStartMin Int      @default(540) @map("work_start_min")
  workEndMin   Int      @default(1080) @map("work_end_min")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tasks             Task[]
  reminders         Reminder[]
  actions           ActionLog[]
  pushSubscriptions PushSubscription[]
  plans             Plan[]

  @@map("users")
}

model Task {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  title          String
  notes          String?
  status         TaskStatus @default(todo)
  priority       Priority   @default(medium)
  dueAt          DateTime?  @map("due_at")
  scheduledFor   DateTime?  @map("scheduled_for")
  estimateMin    Int?       @map("estimate_min")
  project        String?
  tags           String[]   @default([])
  recurrenceRule String?    @map("recurrence_rule")
  parentId       String?    @map("parent_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  completedAt    DateTime?  @map("completed_at")
  deletedAt      DateTime?  @map("deleted_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Task?      @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks  Task[]     @relation("Subtasks")
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@map("tasks")
}

model Reminder {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  taskId         String?        @map("task_id")
  kind           ReminderKind   @default(reminder)
  message        String
  fireAt         DateTime       @map("fire_at")
  recurrenceRule String?        @map("recurrence_rule")
  status         ReminderStatus @default(scheduled)
  channels       String[]       @default(["push"])
  lastFiredAt    DateTime?      @map("last_fired_at")
  triggerRunId   String?        @map("trigger_run_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, status, fireAt])
  @@map("reminders")
}

// A proposed or accepted schedule for a day (or a week, starting on `date`).
model Plan {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  date        String // local calendar date the plan starts on, e.g. 2026-10-21
  days        Int        @default(1)
  status      PlanStatus @default(proposed)
  blocks      Json // [{ taskId, title, start, end }] with ISO instants
  unscheduled Json // [{ taskId, title, reason }]
  createdAt   DateTime   @default(now()) @map("created_at")
  acceptedAt  DateTime?  @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, status])
  @@map("plans")
}

// One per installed browser/device that allowed notifications.
model PushSubscription {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  endpoint    String    @unique
  p256dh      String
  auth        String
  deviceLabel String?   @map("device_label")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Every state change goes through here; powers undo and audit.
model ActionLog {
  id     String   @id @default(cuid())
  userId String   @map("user_id")
  ts     DateTime @default(now())
  tool   String
  args   Json
  before Json?
  after  Json?
  undone Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts])
  @@map("action_log")
}
