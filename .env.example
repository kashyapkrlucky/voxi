# Copy to .env and fill in. Never commit .env.

# --- Neon (Postgres) ---
# Neon console → your project → Connect. Use a `dev` branch for local work.
# Pooled URL (host contains "-pooler") for the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) URL for Prisma migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- OpenAI (agent in Phase 1, speech in Phase 2) ---
OPENAI_API_KEY="sk-..."
# Model names are configurable so they can be changed without code edits.
OPENAI_MODEL="gpt-5-mini"
# low passes all evals (~3.7s median turn); minimal is ~1s faster but skips some clarifying questions.
OPENAI_REASONING_EFFORT="low"
# Voice (Phase 2), used when "OpenAI" is picked in the voice settings bar.
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer
OPENAI_TTS_VOICE="alloy"

# --- Google sign-in via Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# For production add https://YOUR-DOMAIN/api/auth/callback/google too.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Anyone with a verified Google account can sign in. To restrict it, list the allowed emails (comma-separated).
# AUTH_ALLOWED_EMAILS="you@example.com,friend@example.com"
# Local only: skip sign-in and act as OWNER_EMAIL (ignored in production builds).
# AUTH_DEV_BYPASS="true"

# --- Trigger.dev (reminders in Phase 3) ---
# Dashboard → project → API keys. Dev key starts with tr_dev_, prod with tr_prod_.
TRIGGER_SECRET_KEY="tr_dev_..."
TRIGGER_PROJECT_REF="proj_..."

# --- Web push (Phase 3) ---
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""   # same value as VAPID_PUBLIC_KEY (exposed to the browser)
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Set to "off" to stop creating Trigger.dev runs (tests do this automatically).
# REMINDER_SCHEDULER="off"

# --- Owner ---
# Identity used by AUTH_DEV_BYPASS locally. Doesn't restrict who can sign in.
OWNER_EMAIL="you@example.com"
# Fallback timezone for new accounts when the visitor's can't be detected (on Vercel it comes from the request).
OWNER_TIMEZONE="UTC"
